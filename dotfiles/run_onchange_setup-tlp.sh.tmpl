{{- $osID := "" -}}
{{- with .chezmoi.osRelease }}
  {{- $osID = or .id "" -}}
{{- end -}}
{{- if and (eq .chezmoi.os "linux") (eq $osID "arch") -}}
#!/usr/bin/env bash
set -euo pipefail

{{ template "load-resolved-host-state.sh" . }}

config_path=/etc/tlp.d/01-accel-os.conf
reload_tlp=0

if has_feature laptop; then
  if (( tlp_configured )); then
config="$(mktemp)"
trap 'rm -f "$config"' EXIT

cat >"$config" <<EOF
START_CHARGE_THRESH_${tlp_battery}=${tlp_start}
STOP_CHARGE_THRESH_${tlp_battery}=${tlp_stop}
EOF

sudo install -Dm0644 \
  "$config" \
  "$config_path"
reload_tlp=1
  fi
else
if [[ -e "$config_path" ]]; then
  sudo rm -f "$config_path"
  reload_tlp=1
fi
fi

if (( reload_tlp )) && command -v tlp >/dev/null 2>&1; then
  sudo tlp start
fi
{{ end }}