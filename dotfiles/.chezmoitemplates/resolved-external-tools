{{- $hostname := .chezmoi.hostname -}}
{{- $host := dict -}}
{{- if hasKey .hosts $hostname -}}
  {{- $host = index .hosts $hostname -}}
{{- end -}}
{{- $features := list -}}
{{- if hasKey $host "features" -}}
  {{- $features = index $host "features" -}}
{{- end -}}
{{- $externalTools := .external_tools.linux.arch.github_release -}}
{{- range $tools := $externalTools.base -}}
  {{- range $tool := $tools -}}
{{ printf "external_tool\t%s\t%s\t%s\t%s\t%s\n" $tool.name $tool.url $tool.archive_sha256 $tool.binary $tool.binary_sha256 -}}
  {{- end -}}
{{- end -}}
{{- range $feature := $features -}}
  {{- if hasKey $externalTools.features $feature -}}
    {{- range $tools := index $externalTools.features $feature -}}
      {{- range $tool := $tools -}}
{{ printf "external_tool\t%s\t%s\t%s\t%s\t%s\n" $tool.name $tool.url $tool.archive_sha256 $tool.binary $tool.binary_sha256 -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}