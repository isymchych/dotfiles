{{- $osID := "" -}}
{{- with .chezmoi.osRelease }}
  {{- $osID = or .id "" -}}
{{- end -}}
{{- if and (eq .chezmoi.os "linux") (eq $osID "arch") -}}
{{- $host := dict -}}
{{- $knownHost := false -}}
{{- if hasKey .hosts .chezmoi.hostname -}}
  {{- $host = index .hosts .chezmoi.hostname -}}
  {{- $knownHost = true -}}
{{- end -}}
{{- $features := list -}}
{{- if hasKey $host "features" -}}
  {{- $features = index $host "features" -}}
{{- end -}}
#!/usr/bin/env bash
set -euo pipefail

{{- if not $knownHost }}
printf 'Warning: host %s is not declared in hosts.yaml; enabling base services only.\n' \
  {{ .chezmoi.hostname | quote }} >&2
{{- end }}

system_services=(
{{- range .services.linux.arch.base.system.enabled }}
  {{ . | quote }}
{{- end }}
{{- range $feature := $features }}
  {{- if hasKey $.services.linux.arch.features $feature }}
    {{- range (index $.services.linux.arch.features $feature).system.enabled }}
  {{ . | quote }}
    {{- end }}
  {{- end }}
{{- end }}
)

user_services=(
{{- range .services.linux.arch.base.user.enabled }}
  {{ . | quote }}
{{- end }}
{{- range $feature := $features }}
  {{- if hasKey $.services.linux.arch.features $feature }}
    {{- range (index $.services.linux.arch.features $feature).user.enabled }}
  {{ . | quote }}
    {{- end }}
  {{- end }}
{{- end }}
)

disabled_system_services=(
{{- range .services.linux.arch.base.system.disabled }}
  {{ . | quote }}
{{- end }}
{{- if $knownHost }}
{{- range $feature, $featureServices := .services.linux.arch.features }}
  {{- if not (has $feature $features) }}
    {{- range $featureServices.system.enabled }}
  {{ . | quote }}
    {{- end }}
  {{- end }}
{{- end }}
{{- end }}
)

disabled_user_services=(
{{- if $knownHost }}
{{- range $feature, $featureServices := .services.linux.arch.features }}
  {{- if not (has $feature $features) }}
    {{- range $featureServices.user.enabled }}
  {{ . | quote }}
    {{- end }}
  {{- end }}
{{- end }}
{{- end }}
)

assert_disjoint() {
  local enabled_name=$1
  local disabled_name=$2
  local -n enabled=$enabled_name
  local -n disabled=$disabled_name
  local enabled_service
  local disabled_service

  for enabled_service in "${enabled[@]}"; do
    for disabled_service in "${disabled[@]}"; do
      if [[ "$enabled_service" == "$disabled_service" ]]; then
        printf 'Service %s is configured as both enabled and disabled.\n' \
          "$enabled_service" >&2
        exit 1
      fi
    done
  done
}

assert_disjoint system_services disabled_system_services
assert_disjoint user_services disabled_user_services

if [ "${#system_services[@]}" -gt 0 ]; then
  sudo systemctl enable --now "${system_services[@]}"
fi

if [ "${#user_services[@]}" -gt 0 ]; then
  systemctl --user enable --now "${user_services[@]}"
fi

for service in "${disabled_system_services[@]}"; do
  if systemctl cat "$service" >/dev/null 2>&1; then
    sudo systemctl disable --now "$service"
  fi
done

for service in "${disabled_user_services[@]}"; do
  if systemctl --user cat "$service" >/dev/null 2>&1; then
    systemctl --user disable --now "$service"
  fi
done
{{ end }}