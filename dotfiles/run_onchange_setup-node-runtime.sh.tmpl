{{- $osID := "" -}}
{{- with .chezmoi.osRelease }}
  {{- $osID = or .id "" -}}
{{- end -}}
{{- if or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (eq $osID "arch")) -}}
#!/usr/bin/env bash
set -euo pipefail

readonly node_version={{ include "../.node-version" | trim | quote }}

command -v fnm >/dev/null 2>&1 || {
  printf 'fnm is required to install Node %s\n' "$node_version" >&2
  exit 1
}

fnm install --progress=never "$node_version"
{{ end }}