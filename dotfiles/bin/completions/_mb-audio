#compdef mb-audio

_mb_audio_device() {
  local index=2

  while (( index < CURRENT )); do
    case ${words[index]} in
      speakers|mic)
        print -r -- "${words[index]}"
        return
        ;;
    esac
    (( index += 1 ))
  done
}

_mb-audio() {
  local context device state state_descr line
  typeset -A opt_args

  device=$(_mb_audio_device)

  _arguments -C -s \
    '(-n --notify)'{-n,--notify}'[show a desktop notification]' \
    '(-h --help)'{-h,--help}'[show help]' \
    '1:device:(speakers mic)' \
    '2:action:->action'

  if [[ $state == action ]]; then
    case $device in
      speakers)
        _values 'speaker action' status mute unmute toggle up down
        ;;
      mic)
        _values 'microphone action' status mute unmute toggle
        ;;
    esac
  fi
}
