#compdef mb-screenshot

_mb-screenshot() {
  local state

  _arguments -C \
    '1:mode or delay:->first' \
    '2:delay:->delay'

  case $state in
    first)
      _alternative \
        'mode:capture mode:(screen window region menu)' \
        'delay:delay in seconds:_message "non-negative integer"'
      ;;
    delay)
      _message 'non-negative integer'
      ;;
  esac
}