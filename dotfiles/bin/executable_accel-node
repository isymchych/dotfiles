#!/usr/bin/env bash

set -euo pipefail

: "${ACCEL_OS:?ACCEL_OS must point at repo root}"

readonly version_file="$ACCEL_OS/.node-version"

[[ -r "$version_file" ]] || {
  printf 'accel-node: missing Node version file: %s\n' "$version_file" >&2
  exit 1
}

command -v fnm >/dev/null 2>&1 || {
  printf 'accel-node: fnm is required to run repo-managed Node commands\n' >&2
  exit 1
}

exec fnm exec --using="$version_file" node "$@"
