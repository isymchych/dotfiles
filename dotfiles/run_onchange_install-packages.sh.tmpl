{{- $osID := "" -}}
{{- with .chezmoi.osRelease }}
  {{- $osID = or .id "" -}}
{{- end -}}
{{- if and (eq .chezmoi.os "linux") (eq $osID "arch") -}}
{{- $host := dict -}}
{{- $knownHost := false -}}
{{- if hasKey .hosts .chezmoi.hostname -}}
  {{- $host = index .hosts .chezmoi.hostname -}}
  {{- $knownHost = true -}}
{{- end -}}
{{- $features := list -}}
{{- if hasKey $host "features" -}}
  {{- $features = index $host "features" -}}
{{- end -}}
#!/bin/bash
set -euo pipefail

{{- if not $knownHost }}
printf 'Warning: host %s is not declared in hosts.yaml; installing base packages only.\n' \
  {{ .chezmoi.hostname | quote }} >&2
{{- end }}

pacman_packages=(
{{- range $packages := .packages.linux.arch.pacman.base }}
  {{- range $packages }}
  {{ . | quote }}
  {{- end }}
{{- end }}
{{- range $feature := $features }}
  {{- if hasKey $.packages.linux.arch.pacman.features $feature }}
    {{- range $packages := index $.packages.linux.arch.pacman.features $feature }}
      {{- range $packages }}
  {{ . | quote }}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
)

if [ "${#pacman_packages[@]}" -gt 0 ]; then
  sudo pacman -S --needed "${pacman_packages[@]}"
fi

aur_packages=(
{{- range $packages := .packages.linux.arch.aur.base }}
  {{- range $packages }}
  {{ . | quote }}
  {{- end }}
{{- end }}
{{- range $feature := $features }}
  {{- if hasKey $.packages.linux.arch.aur.features $feature }}
    {{- range $packages := index $.packages.linux.arch.aur.features $feature }}
      {{- range $packages }}
  {{ . | quote }}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
)

if [ "${#aur_packages[@]}" -gt 0 ]; then
  if ! command -v yay >/dev/null 2>&1; then
    printf 'Missing AUR helper (install yay) to install: %s\n' "${aur_packages[*]}" >&2
    exit 1
  fi

  yay -S --needed "${aur_packages[@]}"
fi
{{ end }}
