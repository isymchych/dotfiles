{{- $osID := "" -}}
{{- with .chezmoi.osRelease }}
  {{- $osID = or .id "" -}}
{{- end -}}
{{- if and (eq .chezmoi.os "linux") (eq $osID "arch") -}}
#!/bin/bash
set -euo pipefail

{{ template "load-resolved-host-state.sh" . }}

if (( ! known_host )); then
printf 'Warning: host %s is not declared in hosts.yaml; installing base packages only.\n' \
  "$resolved_hostname" >&2
fi

if [ "${#pacman_packages[@]}" -gt 0 ]; then
  sudo pacman -S --needed "${pacman_packages[@]}"
fi

if [ "${#aur_packages[@]}" -gt 0 ]; then
  if ! command -v yay >/dev/null 2>&1; then
    printf 'Missing AUR helper (install yay) to install: %s\n' "${aur_packages[*]}" >&2
    exit 1
  fi

  yay -S --needed "${aur_packages[@]}"
fi
{{ end }}
