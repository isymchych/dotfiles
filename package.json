{
  "name": "accel-os",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "ai/pi",
    "ai/skills",
    "packages/shared",
    "scripts"
  ],
  "allowScripts": {
    "koffi@2.16.2": true,
    "tilth@0.9.0": true
  },
  "scripts": {
    "check": "npm run check:completions && npm run fmt:check && npm run lint && npm run typecheck && npm test",
    "check:completions": "node scripts/scripts/check-completions.ts",
    "fmt": "oxfmt ai/pi ai/skills packages/shared scripts",
    "fmt:check": "oxfmt --check ai/pi ai/skills packages/shared scripts",
    "lint": "oxlint ai/pi ai/skills packages/shared scripts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
