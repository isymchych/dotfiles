#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

case "${1:-}" in
  "")
    mode="write"
    ;;
  --check)
    mode="check"
    ;;
  *)
    printf 'Usage: %s [--check]\n' "$0" >&2
    exit 2
    ;;
esac

ACCEL_OS="$repo_root" EMACS_FORMAT_MODE="$mode" \
  exec emacs --batch -Q \
  --directory "$repo_root/scripts" \
  --load "$repo_root/scripts/format-emacs.el"